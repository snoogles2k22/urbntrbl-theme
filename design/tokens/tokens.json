{
  "$description": "URBN TRBL Design Tokens. Single Source of Truth. Format orientiert sich am W3C Design Tokens Format (DTCG): Gruppen, Blätter mit $value, Aliase als {pfad.zum.token}. Werte sind CSS-fertige Strings. Alles mit 'PLATZHALTER' in $description ist noch nicht freigegeben.",

  "color": {
    "$type": "color",
    "$description": "Stufe 1: Primitive (neutral, brand, signal). Stufe 2: Semantik (text, bg, border, action). Komponenten greifen nur auf Stufe 2 zu.",

    "neutral": {
      "0":    { "$value": "#ffffff" },
      "50":   { "$value": "#f7f7f7" },
      "100":  { "$value": "#ededed" },
      "200":  { "$value": "#d9d9d9" },
      "300":  { "$value": "#b8b8b8" },
      "400":  { "$value": "#8f8f8f" },
      "500":  { "$value": "#6b6b6b" },
      "600":  { "$value": "#4d4d4d" },
      "700":  { "$value": "#333333" },
      "800":  { "$value": "#1f1f1f" },
      "900":  { "$value": "#111111" },
      "1000": { "$value": "#000000" }
    },

    "brand": {
      "primary":          { "$value": "#111111", "$description": "PLATZHALTER: Hauptfarbe der Marke, Freigabe offen." },
      "primary-contrast": { "$value": "#ffffff", "$description": "PLATZHALTER: Text/Icon auf primary." },
      "accent":           { "$value": "#ff4d00", "$description": "PLATZHALTER: Akzent (Sale, Highlights)." },
      "accent-contrast":  { "$value": "#111111", "$description": "PLATZHALTER: Text/Icon auf accent." }
    },

    "signal": {
      "success": { "$value": "#1f7a3a" },
      "warning": { "$value": "#b36b00" },
      "error":   { "$value": "#b3261e" },
      "info":    { "$value": "#1f5fa8" }
    },

    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted":   { "$value": "{color.neutral.500}" },
      "subtle":  { "$value": "{color.neutral.400}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "link":    { "$value": "{color.neutral.900}" },
      "sale":    { "$value": "{color.brand.accent}" },
      "error":   { "$value": "{color.signal.error}" },
      "success": { "$value": "{color.signal.success}" }
    },

    "bg": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle":  { "$value": "{color.neutral.50}" },
      "muted":   { "$value": "{color.neutral.100}" },
      "inverse": { "$value": "{color.neutral.900}" },
      "accent":  { "$value": "{color.brand.accent}" },
      "overlay": { "$value": "rgb(0 0 0 / 0.55)", "$description": "Backdrop für Drawer/Modal." }
    },

    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong":  { "$value": "{color.neutral.900}" },
      "subtle":  { "$value": "{color.neutral.100}" },
      "focus":   { "$value": "{color.brand.accent}", "$description": "Fokusring, muss 3:1 gegen bg.default halten." }
    },

    "action": {
      "primary-bg":         { "$value": "{color.brand.primary}" },
      "primary-bg-hover":   { "$value": "{color.neutral.700}", "$description": "PLATZHALTER: Hover-Ableitung, nach Brand-Freigabe prüfen." },
      "primary-text":       { "$value": "{color.brand.primary-contrast}" },
      "secondary-bg":       { "$value": "transparent" },
      "secondary-border":   { "$value": "{color.neutral.900}" },
      "secondary-text":     { "$value": "{color.neutral.900}" },
      "disabled-bg":        { "$value": "{color.neutral.100}" },
      "disabled-text":      { "$value": "{color.neutral.400}" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "PLATZHALTER: Systemstack bis die Markenschrift feststeht. Webfonts später selbst gehostet in assets/fonts/, nicht über Shopify font_picker.",
      "heading": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"], "$description": "PLATZHALTER" },
      "body":    { "$value": ["system-ui", "-apple-system", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"], "$description": "PLATZHALTER" },
      "mono":    { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid-Skala per clamp(): min bei 360px, max bei 1440px Viewport. Body bleibt fix für Lesbarkeit.",
      "xs":      { "$value": "0.75rem" },
      "sm":      { "$value": "0.875rem" },
      "md":      { "$value": "1rem" },
      "lg":      { "$value": "1.125rem" },
      "xl":      { "$value": "clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem)" },
      "2xl":     { "$value": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)" },
      "3xl":     { "$value": "clamp(1.875rem, 1.5rem + 1.7vw, 2.75rem)" },
      "display": { "$value": "clamp(2.5rem, 1.8rem + 3.1vw, 4.5rem)" }
    },
    "line-height": {
      "$type": "number",
      "tight":  { "$value": 1.1 },
      "snug":   { "$value": 1.25 },
      "normal": { "$value": 1.5 },
      "loose":  { "$value": 1.7 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.06em" },
      "caps":   { "$value": "0.1em", "$description": "Für Uppercase-Labels." }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px-Raster. Nummer = Vielfaches von 4px (Tailwind-Konvention).",
    "0":  { "$value": "0" },
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.25rem" },
    "6":  { "$value": "1.5rem" },
    "8":  { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" },
    "32": { "$value": "8rem" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm":   { "$value": "0.125rem" },
    "md":   { "$value": "0.25rem" },
    "lg":   { "$value": "0.5rem" },
    "xl":   { "$value": "1rem" },
    "full": { "$value": "9999px" }
  },

  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "thick":    { "$value": "2px" },
    "focus":    { "$value": "2px" }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.06)" },
    "md": { "$value": "0 4px 12px rgb(0 0 0 / 0.08)" },
    "lg": { "$value": "0 12px 32px rgb(0 0 0 / 0.12)" }
  },

  "layout": {
    "$type": "dimension",
    "container-max":    { "$value": "1440px" },
    "container-narrow": { "$value": "800px" },
    "gutter":           { "$value": "{space.4}", "$description": "Seitenrand mobil." },
    "gutter-lg":        { "$value": "{space.8}", "$description": "Seitenrand ab lg." },
    "section-gap":      { "$value": "clamp(3rem, 2rem + 4vw, 6rem)" },
    "grid-gap":         { "$value": "{space.4}" },
    "header-height":    { "$value": "64px" }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Nur Doku und Generator-Kommentar: CSS-Variablen funktionieren nicht in @media. In CSS die Pixelwerte direkt verwenden und hier nachschlagen. Beim Port in Tailwind/Theme-Config übernehmen.",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter":    { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },

  "z": {
    "$type": "number",
    "$description": "Stacking-Ebenen. Komponenten nutzen diese, nie eigene Zahlen.",
    "base":     { "$value": 0 },
    "raised":   { "$value": 10 },
    "dropdown": { "$value": 100 },
    "sticky":   { "$value": 200 },
    "overlay":  { "$value": 300 },
    "drawer":   { "$value": 400 },
    "modal":    { "$value": 500 },
    "toast":    { "$value": 600 }
  },

  "$scopes": {
    "inverse": {
      "$selector": "[data-tone=\"inverse\"]",
      "$description": "Dunkle Flächen (Section-Setting tone: inverse). Überschreibt nur Semantik, nie Primitive. PLATZHALTER bis zur Brand-Freigabe.",
      "color": {
        "text": {
          "default": { "$value": "{color.neutral.0}" },
          "muted":   { "$value": "{color.neutral.300}" },
          "subtle":  { "$value": "{color.neutral.400}" },
          "inverse": { "$value": "{color.neutral.900}" },
          "link":    { "$value": "{color.neutral.0}" }
        },
        "bg": {
          "default": { "$value": "{color.neutral.900}" },
          "subtle":  { "$value": "{color.neutral.800}" },
          "muted":   { "$value": "{color.neutral.700}" },
          "inverse": { "$value": "{color.neutral.0}" }
        },
        "border": {
          "default": { "$value": "{color.neutral.700}" },
          "strong":  { "$value": "{color.neutral.0}" },
          "subtle":  { "$value": "{color.neutral.800}" }
        },
        "action": {
          "primary-bg":       { "$value": "{color.neutral.0}" },
          "primary-bg-hover": { "$value": "{color.neutral.200}" },
          "primary-text":     { "$value": "{color.neutral.900}" },
          "secondary-border": { "$value": "{color.neutral.0}" },
          "secondary-text":   { "$value": "{color.neutral.0}" },
          "disabled-bg":      { "$value": "{color.neutral.800}" },
          "disabled-text":    { "$value": "{color.neutral.500}" }
        }
      }
    }
  }
}

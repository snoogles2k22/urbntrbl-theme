{%- comment -%}
  Footer. Spec: design/components/footer.md
  [RECHT-PRÜFEN] Footnote wording (§ 19 UStG) and legal link set are
  assumptions, not legal advice. Legal links without URL render as plain
  placeholder text, never as dead links.
  Note: render arguments do not evaluate filters; values are assigned first.
{%- endcomment -%}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-form-field.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign footer_tone = section.settings.tone | default: 'inverse'
  assign footer_menu = linklists[section.settings.menu]
  assign nav_label = 'layout.footer.nav_label' | t
  assign legal_label = 'layout.footer.legal_label' | t

  # Legal links: section setting first, then the matching Shopify policy.
  # Withdrawal falls back to the refund policy [ANNAHME]. Imprint has no fallback.
  assign imprint_url = section.settings.imprint_url
  assign privacy_url = section.settings.privacy_url
  if privacy_url == blank and shop.privacy_policy.body != blank
    assign privacy_url = shop.privacy_policy.url
  endif
  assign terms_url = section.settings.terms_url
  if terms_url == blank and shop.terms_of_service.body != blank
    assign terms_url = shop.terms_of_service.url
  endif
  assign withdrawal_url = section.settings.withdrawal_url
  if withdrawal_url == blank and shop.refund_policy.body != blank
    assign withdrawal_url = shop.refund_policy.url
  endif
  assign legal_keys = 'imprint,privacy,terms,withdrawal' | split: ','

  case settings.price_tax_mode
    when 'included'
      assign footnote = 'products.price.footnote_included' | t
    when 'kleinunternehmer'
      assign footnote = 'products.price.footnote_kleinunternehmer' | t
    else
      assign footnote = 'products.price.footnote_none' | t
  endcase
  assign shipping_url = ''
  if shop.shipping_policy.body != blank
    assign shipping_url = shop.shipping_policy.url
  elsif settings.price_shipping_page != blank
    assign shipping_url = settings.price_shipping_page
  endif

  assign current_year = 'now' | date: '%Y'
  assign copyright = 'layout.footer.copyright' | t: year: current_year, shop: shop.name
-%}

<div class="ut-footer" data-tone="{{ footer_tone }}">
  <div class="ut-footer__inner">
    {%- if section.settings.show_newsletter or footer_menu.links.size > 0 -%}
      <div class="ut-footer__top">
        {%- if section.settings.show_newsletter -%}
          <div class="ut-footer__newsletter">
            {%- render 'newsletter-form', id: 'NewsletterFooter', privacy_url: privacy_url -%}
          </div>
        {%- endif -%}

        {%- if footer_menu.links.size > 0 -%}
          <nav class="ut-footer__nav" aria-label="{{ nav_label | escape }}">
            <ul class="ut-footer__list" role="list">
              {%- for link in footer_menu.links -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="ut-footer__link"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ut-footer__bottom">
      <nav class="ut-footer__legal" aria-label="{{ legal_label | escape }}">
        <ul class="ut-footer__legal-list" role="list">
          {%- for legal_key in legal_keys -%}
            {%- liquid
              assign legal_label_key = 'layout.footer.legal.' | append: legal_key
              assign legal_text = legal_label_key | t
              case legal_key
                when 'imprint'
                  assign legal_url = imprint_url
                when 'privacy'
                  assign legal_url = privacy_url
                when 'terms'
                  assign legal_url = terms_url
                when 'withdrawal'
                  assign legal_url = withdrawal_url
              endcase
            -%}
            <li>
              {%- if legal_url != blank -%}
                <a href="{{ legal_url }}" class="ut-footer__link">{{ legal_text }}</a>
              {%- else -%}
                <span class="ut-footer__placeholder">{{ legal_text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <p class="ut-footer__footnote">
        {{ footnote }}
        {%- if shipping_url != blank %}
          <a href="{{ shipping_url }}" class="ut-footer__link">{{ 'layout.footer.shipping_info' | t }}</a>
        {%- endif -%}
      </p>

      <p class="ut-footer__copyright">{{ copyright }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "ut-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:sections.footer.settings.tone",
      "info": "t:sections.footer.settings.tone_info",
      "default": "inverse",
      "options": [
        { "value": "default", "label": "t:sections.footer.settings.tone_default" },
        { "value": "inverse", "label": "t:sections.footer.settings.tone_inverse" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.footer.settings.menu"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.legal_header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.legal_info"
    },
    {
      "type": "url",
      "id": "imprint_url",
      "label": "t:sections.footer.settings.imprint_url"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "t:sections.footer.settings.privacy_url"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "t:sections.footer.settings.terms_url"
    },
    {
      "type": "url",
      "id": "withdrawal_url",
      "label": "t:sections.footer.settings.withdrawal_url"
    }
  ]
}
{% endschema %}

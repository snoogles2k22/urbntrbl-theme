{%- comment -%}
  Footer. Spec: design/components/footer.md
  [RECHT-PRÜFEN] Price note wording (§ 19 UStG) and legal link set are
  assumptions, not legal advice.
  Legal links come from the shop menu (default handle "footer"). Every menu
  entry renders with its href; nothing is hidden because a policy is still
  empty. Order and titles are maintained in the menu.
  Note: render arguments do not evaluate filters; values are assigned first.
{%- endcomment -%}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-form-field.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign footer_tone = section.settings.tone | default: 'inverse'
  assign legal_menu = linklists[section.settings.menu]
  assign legal_label = 'layout.footer.legal_label' | t
  assign privacy_url = shop.privacy_policy.url
  assign price_note = 'layout.footer.price_note' | t

  # Footnote for the * marker. The tax statement is the price note above it,
  # so kleinunternehmer and none only name the shipping costs.
  if settings.price_tax_mode == 'included'
    assign footnote = 'products.price.footnote_included' | t
  else
    assign footnote = 'products.price.footnote_none' | t
  endif
  assign shipping_url = ''
  if shop.shipping_policy.body != blank
    assign shipping_url = shop.shipping_policy.url
  elsif settings.price_shipping_page != blank
    assign shipping_url = settings.price_shipping_page
  endif

  assign current_year = 'now' | date: '%Y'
  assign copyright = 'layout.footer.copyright' | t: year: current_year, shop: shop.name
-%}

<div class="ut-footer" data-tone="{{ footer_tone }}">
  <div class="ut-footer__inner">
    {%- if section.settings.show_newsletter -%}
      <div class="ut-footer__newsletter">
        {%- render 'newsletter-form', id: 'NewsletterFooter', privacy_url: privacy_url -%}
      </div>
    {%- endif -%}

    <div class="ut-footer__bottom">
      {%- if legal_menu.links.size > 0 -%}
        <nav class="ut-footer__legal" aria-label="{{ legal_label | escape }}">
          <ul class="ut-footer__legal-list" role="list">
            {%- for link in legal_menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="ut-footer__link"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <p class="ut-footer__price-note">{{ price_note }}</p>

      <p class="ut-footer__footnote">
        {{ footnote }}
        {%- if shipping_url != blank %}
          <a href="{{ shipping_url }}" class="ut-footer__link">{{ 'layout.footer.shipping_info' | t }}</a>
        {%- endif -%}
      </p>

      <p class="ut-footer__copyright">{{ copyright }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "ut-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:sections.footer.settings.tone",
      "info": "t:sections.footer.settings.tone_info",
      "default": "inverse",
      "options": [
        { "value": "default", "label": "t:sections.footer.settings.tone_default" },
        { "value": "inverse", "label": "t:sections.footer.settings.tone_inverse" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.footer.settings.menu",
      "info": "t:sections.footer.settings.menu_info",
      "default": "footer"
    }
  ]
}
{% endschema %}
